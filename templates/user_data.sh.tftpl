#!/bin/bash
set -euxo pipefail

dnf install -y git python3 python3-pip jq postgresql16

%{ for key in ssh_extra_public_keys ~}
echo '${key}' >> /home/ec2-user/.ssh/authorized_keys
%{ endfor ~}

APP_DIR=/opt/togglemaster
git clone --depth 1 "${app_repo_url}" "$APP_DIR"
python3 -m venv "$APP_DIR/venv"
"$APP_DIR/venv/bin/pip" install --no-cache-dir -r "$APP_DIR/requirements.txt"

cat > "$APP_DIR/start.sh" <<'START'
#!/bin/bash
set -euo pipefail

SECRET=$(aws secretsmanager get-secret-value \
  --region "${aws_region}" \
  --secret-id "${db_secret_arn}" \
  --query SecretString --output text)

export DB_HOST="${db_host}"
export DB_PORT="${db_port}"
export DB_NAME="${db_name}"
export DB_USER="$(jq -r .username <<<"$SECRET")"
export DB_PASSWORD="$(jq -r .password <<<"$SECRET")"
export FLASK_APP=app.py

cd /opt/togglemaster
venv/bin/flask init-db
exec venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 app:app
START
chmod 755 "$APP_DIR/start.sh"
chown -R ec2-user:ec2-user "$APP_DIR"

cat > /etc/systemd/system/togglemaster.service <<'UNIT'
[Unit]
Description=ToggleMaster (Flask + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
ExecStart=/opt/togglemaster/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

until pg_isready -h "${db_host}" -p "${db_port}" -q; do
  sleep 5
done

systemctl daemon-reload
systemctl enable --now togglemaster
